# Exclude development, test, and documentation folders
prune .github
prune docs
prune tests
prune src/edx_proctoring/static/proctoring/spec

# Exclude root level configuration and build files
exclude Makefile
exclude conftest.py
exclude .gitignore
exclude tox.ini
exclude CHANGELOG.rst
exclude uv.lock

# Exclude test/coverage artifacts from sdist
prune htmlcov
global-exclude coverage.xml
global-exclude .coverage
